# Apptainer recipe: aarch64 (Arm/Grace) Kilosort4 image for NVIDIA GH200 GPU nodes.
#
# The published ghcr.io/allenneuraldynamics/aind-ephys-spikesort-kilosort4 images
# are amd64-only. This recipe mirrors environment/Dockerfile_kilosort4 using the
# official PyTorch aarch64 CUDA wheels, which bundle their own CUDA libraries.
#
# CUDA version: the wheel's CUDA must not be newer than what the host driver supports.
# Arrhenius GH200 nodes run driver 580 (CUDA 13.0); NGC pytorch 26.02 (CUDA 13.1)
# crashes in cuFFT plan creation there, while cu128 wheels work.
#
# Build on a GPU node (the image architecture follows the build node), from the repo root:
#
#   sbatch scripts/build_kilosort4_arm64.sh
#
# The script builds the image and checks it with the GPU.

Bootstrap: docker
# Full (non-slim) image: includes git (needed at runtime to clone capsule code) and compilers
From: python:3.12-bookworm

%files
    environment/package-versions.txt /opt/package-versions.txt

%post
    set -e
    export PIP_NO_CACHE_DIR=1
    git --version

    python -m pip install --upgrade pip

    # CUDA 12.8 torch for aarch64; pin it so later installs can't swap it for another build
    python -m pip install "torch==2.11.0" --index-url https://download.pytorch.org/whl/cu128
    python -c "import torch; print(f'torch=={torch.__version__}')" > /opt/torch-constraint.txt
    cat /opt/torch-constraint.txt

    grep -E 'log-schema|aind-data-schema|scipy' /opt/package-versions.txt \
        | xargs python -m pip install -c /opt/torch-constraint.txt

    SPIKEINTERFACE_VERSION=$(grep '^spikeinterface==' /opt/package-versions.txt | cut -d'=' -f3)
    python -m pip install -c /opt/torch-constraint.txt \
        "spikeinterface[full]==${SPIKEINTERFACE_VERSION}" \
        "kilosort==4.1.7"

    # Fail the build if torch is not a CUDA 12 build or cannot exchange arrays with numpy
    python -c "
import numpy, torch
assert (torch.version.cuda or '').startswith('12.'), f'unexpected torch CUDA build: {torch.version.cuda}'
t = torch.from_numpy(numpy.arange(3.0))
assert t.numpy().sum() == 3.0
print('torch', torch.__version__, 'CUDA', torch.version.cuda, '| numpy', numpy.__version__, '| numpy interop OK')
"

%environment
    export NUMBA_CACHE_DIR=/tmp/numba_cache
    export MPLCONFIGDIR=/tmp/matplotlib_cache

%labels
    Description aarch64 Kilosort4 4.1.7 + SpikeInterface (torch cu128) for aind-ephys-pipeline 1.4.0 on GH200
