# KiloSort4 container for ARM64 (NVIDIA GH200 / Grace Hopper)
#
# Build on Dardel gh node:
#   apptainer build --mksquashfs-args "-comp lz4" \
#     /cfs/klemming/projects/supr/dmclab/apptainer_cachedir/kilosort4-arm.sif \
#     kilosort4-arm.def
#
# NOTE: --squashfs-opts "-comp lz4" is required — GH200 compute nodes only support lz4,
# not the default zlib compression.

Bootstrap: docker
From: nvcr.io/nvidia/pytorch:26.02-py3

%labels
    Author aind-ephys-pipeline
    Architecture aarch64 (GH200 / Grace Hopper)
    KiloSort4Version 4.0.38
    SpikeInterfaceVersion 0.103.0

%post
    export DEBIAN_FRONTEND=noninteractive

    # The NGC base image ships scipy 1.17.0 whose PyPI binary wheel bundles
    # OpenBLAS with a NEOVERSEN2 kernel compiled with MAX_THREADS=128.
    # GH200 Grace has 288 hw threads → OpenBLAS segfaults at init.
    #
    # Fix: remove the bundled-OpenBLAS scipy, install scipy-openblas32 (pip
    # package providing OpenBLAS + pkg-config for the build system), then
    # rebuild scipy from source so it links against that shared library
    # instead of statically bundling the broken one.
    pip uninstall -y scipy

    # Provide BLAS for scipy's meson build system
    pip install --no-cache-dir scipy-openblas32

    # get_pkg_config() returns the .pc file CONTENT, not a path.
    # Write it to a file so meson can find it via pkg-config.
    mkdir -p /usr/local/lib/pkgconfig
    python -c "import scipy_openblas32; print(scipy_openblas32.get_pkg_config())" \
        > /usr/local/lib/pkgconfig/scipy-openblas.pc
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig

    # Build scipy from source + install the rest of the stack
    pip install --no-cache-dir --no-binary scipy \
        scipy \
        kilosort==4.0.38 \
        spikeinterface[full]==0.103.0 \
        "aind-data-schema<2.0" \
        aind-log-utils==0.2.3

%environment
    export DEBIAN_FRONTEND=noninteractive
    export OPENBLAS_NUM_THREADS=64

%runscript
    exec python "$@"
