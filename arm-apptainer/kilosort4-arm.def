# KiloSort4 container for ARM64 (NVIDIA GH200 / Grace Hopper)
#
# Build on Dardel gh node:
#   sbatch build-ks4.sh
#
# NOTE: --mksquashfs-args "-comp lz4" is required — GH200 compute nodes only
# support lz4, not the default zlib compression.

Bootstrap: docker
From: nvcr.io/nvidia/pytorch:26.02-py3

%labels
    Author aind-ephys-pipeline
    Architecture aarch64 (GH200 / Grace Hopper)
    KiloSort4Version 4.0.38
    SpikeInterfaceVersion 0.103.0

%post
    export DEBIAN_FRONTEND=noninteractive

    pip install --no-cache-dir scipy-openblas32

    pip install --no-cache-dir \
        kilosort==4.0.38 \
        spikeinterface[full]==0.103.0 \
        "aind-data-schema<2.0" \
        aind-log-utils==0.2.3

    # ── Fix ALL OpenBLAS instances for GH200 (288 hardware threads) ──────
    #
    # The container has FOUR OpenBLAS shared libraries:
    #   1. scipy.libs/libscipy_openblas*.so        (scipy_ prefix, replaced by Part A)
    #   2. numpy.libs/libopenblas64_p*.so           (ILP64 — 64-bit integer BLAS)
    #   3. faiss_cpu.libs/libopenblas*.so            (LP64  — 32-bit integer BLAS)
    #   4. scipy_openblas32/lib/libscipy_openblas.so (the good 0.3.31 copy)
    #
    # Libraries 2 & 3 are old (<0.3.28) and fatally abort on GH200 when the
    # detected CPU count (288) exceeds compile-time MAX_THREADS.
    #
    # Fix: build OpenBLAS 0.3.31 from source in BOTH LP64 and ILP64 variants
    # (NUM_THREADS=512) and replace every bundled copy with the matching one.

    # ── Diagnose: BEFORE state ──
    echo "=== OpenBLAS libraries BEFORE fix ==="
    find / \( -name 'libopenblas*' -o -name 'libscipy_openblas*' \) \
        -not -path '*/proc/*' 2>/dev/null | sort || true
    echo "--- *.libs/ directories (all contents) ---"
    for d in /usr/local/lib/python3.12/dist-packages/*.libs; do
        [ -d "$d" ] && echo "  $d:" && ls -1 "$d" 2>/dev/null | sed 's/^/    /'
    done
    echo "======================================"

    # ── Part A: Replace scipy-prefixed OpenBLAS ──
    python -c "
import glob, os, shutil, site, scipy_openblas32

good = os.path.join(os.path.dirname(scipy_openblas32.__file__), 'lib', 'libscipy_openblas.so')
print(f'Good (scipy-prefix): {good} ({os.path.getsize(good)} bytes)')

for sp in site.getsitepackages():
    for lib in glob.glob(os.path.join(sp, '**', 'libscipy_openblas*.so'), recursive=True):
        if 'scipy_openblas32' in lib:
            continue
        print(f'  Replacing: {lib} ({os.path.getsize(lib)} bytes)')
        shutil.copy2(good, lib)
"

    # ── Part B: Build OpenBLAS 0.3.31 — LP64 and ILP64 variants ──
    echo "=== Downloading OpenBLAS 0.3.31 ==="
    cd /tmp
    curl -sL -o OpenBLAS-0.3.31.tar.gz \
        https://github.com/OpenMathLib/OpenBLAS/releases/download/v0.3.31/OpenBLAS-0.3.31.tar.gz 2>/dev/null \
    || wget -q -O OpenBLAS-0.3.31.tar.gz \
        https://github.com/OpenMathLib/OpenBLAS/releases/download/v0.3.31/OpenBLAS-0.3.31.tar.gz 2>/dev/null \
    || python -c "import urllib.request; urllib.request.urlretrieve('https://github.com/OpenMathLib/OpenBLAS/releases/download/v0.3.31/OpenBLAS-0.3.31.tar.gz', 'OpenBLAS-0.3.31.tar.gz')"
    tar xf OpenBLAS-0.3.31.tar.gz
    cd OpenBLAS-0.3.31

    FFLAGS=""
    command -v gfortran &>/dev/null || FFLAGS="NO_LAPACK=1 NO_LAPACKE=1"

    # Build 1: LP64 (32-bit integers) — for faiss-cpu and system use
    echo "=== Building LP64 variant ==="
    make -j$(nproc) NUM_THREADS=512 USE_OPENMP=0 $FFLAGS 2>&1 | tail -5
    cp -v $(find . -maxdepth 1 -name 'libopenblas*.so' -not -type l | head -1) /tmp/libopenblas_lp64.so
    make PREFIX=/usr/local install 2>&1 | tail -3
    make clean 2>&1 | tail -1

    # Build 2: ILP64 (64-bit integers) — for numpy
    echo "=== Building ILP64 variant ==="
    make -j$(nproc) NUM_THREADS=512 USE_OPENMP=0 INTERFACE64=1 SYMBOLSUFFIX=64_ $FFLAGS 2>&1 | tail -5
    cp -v $(find . -maxdepth 1 -name 'libopenblas*.so' -not -type l | head -1) /tmp/libopenblas_ilp64.so

    echo ""
    ls -lh /tmp/libopenblas_lp64.so /tmp/libopenblas_ilp64.so

    # ── Part C: Replace ALL bundled OpenBLAS in site-packages ──
    echo "=== Replacing bundled OpenBLAS libraries ==="
    python -c "
import glob, os, shutil, site

lp64  = '/tmp/libopenblas_lp64.so'
ilp64 = '/tmp/libopenblas_ilp64.so'

for sp in site.getsitepackages():
    for lib in glob.glob(os.path.join(sp, '**', 'libopenblas*.so'), recursive=True):
        if '/scipy_openblas32/' in lib:
            continue
        # numpy's ILP64 library has '64' in its name
        basename = os.path.basename(lib)
        if '64' in basename:
            src, variant = ilp64, 'ILP64'
        else:
            src, variant = lp64, 'LP64'
        print(f'  [{variant}] {lib}')
        print(f'    old: {os.path.getsize(lib)} bytes')
        shutil.copy2(src, lib)
        print(f'    new: {os.path.getsize(lib)} bytes')
"

    ldconfig
    cd /
    rm -rf /tmp/OpenBLAS-0.3.31 /tmp/OpenBLAS-0.3.31.tar.gz \
           /tmp/libopenblas_lp64.so /tmp/libopenblas_ilp64.so

    # ── Part D: Fix missing shared library dependencies ──────────────────
    # scipy's Fortran extensions (e.g., _fblas.so) reference auditwheel-
    # hashed library names (e.g., libgfortran-daac5196.so.5.0.0) that may
    # not be bundled if the base image installed scipy without full bundling.
    # Fix: detect missing deps via ldd and copy system equivalents.
    echo "=== Fixing missing shared library deps ==="
    python -c "
import subprocess, os, glob, shutil, site, re

for sp in site.getsitepackages():
    scipy_libs = os.path.join(sp, 'scipy.libs')
    if not os.path.isdir(scipy_libs):
        continue
    fixed = 0
    seen = set()
    for ext_pattern in ['scipy/linalg/_fblas*.so', 'scipy/linalg/_flapack*.so',
                        'scipy/special/_ufuncs*.so', 'scipy/sparse/linalg/_eigen/*/*.so']:
        for so_file in glob.glob(os.path.join(sp, ext_pattern)):
            try:
                out = subprocess.check_output(['ldd', so_file], text=True, stderr=subprocess.STDOUT)
            except Exception:
                continue
            for line in out.splitlines():
                if 'not found' not in line:
                    continue
                needed = line.strip().split()[0]
                if needed in seen:
                    continue
                seen.add(needed)
                dest = os.path.join(scipy_libs, needed)
                if os.path.exists(dest):
                    continue
                # Extract base name: libgfortran-daac5196.so.5.0.0 -> libgfortran
                m = re.match(r'(lib\w+)-[0-9a-f]+\.so', needed)
                base = m.group(1) if m else needed.split('.so')[0]
                # Search system library paths for the real library
                found = None
                for d in ['/usr/lib/aarch64-linux-gnu', '/usr/lib', '/lib/aarch64-linux-gnu', '/lib']:
                    candidates = [f for f in glob.glob(os.path.join(d, base + '.so*'))
                                  if os.path.isfile(f) and not os.path.islink(f)]
                    if candidates:
                        found = sorted(candidates)[-1]
                        break
                if found:
                    print(f'  {needed}: {found} -> {dest}')
                    shutil.copy2(found, dest)
                    fixed += 1
                else:
                    print(f'  WARNING: {needed} — no system equivalent found!')
    print(f'{fixed} missing libraries fixed')
"

    # ── Build-time verification: catch import errors before creating SIF ──
    echo "=== Verifying critical imports ==="
    python -c "
import scipy.linalg
print('scipy.linalg import OK')
import numpy as np
a = np.random.randn(100, 100).astype(np.float32)
print(f'numpy matmul OK: {(a @ a).shape}')
import scipy.linalg as la
q, r = la.qr(a.astype(np.float64))
print(f'scipy QR OK: Q={q.shape}, R={r.shape}')
"

    # ── Verify ──
    echo "=== OpenBLAS libraries AFTER fix ==="
    find / \( -name 'libopenblas*' -o -name 'libscipy_openblas*' \) \
        -not -path '*/proc/*' 2>/dev/null | while read f; do
        size=$(stat -c%s "$f" 2>/dev/null || echo "?")
        link=$(readlink "$f" 2>/dev/null || echo "")
        echo "  $f  ($size bytes) ${link:+-> $link}"
    done
    echo "--- *.libs/ directories AFTER fix (all contents) ---"
    for d in /usr/local/lib/python3.12/dist-packages/*.libs; do
        [ -d "$d" ] && echo "  $d:" && ls -lh "$d" 2>/dev/null | tail -n +2 | sed 's/^/    /'
    done
    echo "================================"

%environment
    export DEBIAN_FRONTEND=noninteractive
    export OPENBLAS_NUM_THREADS=64
    # Safety net: source-built LP64 library takes precedence for any
    # standard-symbol BLAS calls not resolved via RPATH.
    export LD_PRELOAD=/usr/local/lib/libopenblas.so

%runscript
    exec python "$@"
