# KiloSort4 container for ARM64 (NVIDIA GH200 / Grace Hopper)
#
# Build on Dardel gh node:
#   apptainer build --mksquashfs-args "-comp lz4" \
#     /cfs/klemming/projects/supr/dmclab/apptainer_cachedir/kilosort4-arm.sif \
#     kilosort4-arm.def
#
# NOTE: --squashfs-opts "-comp lz4" is required — GH200 compute nodes only support lz4,
# not the default zlib compression.

Bootstrap: docker
From: nvcr.io/nvidia/pytorch:26.02-py3

%labels
    Author aind-ephys-pipeline
    Architecture aarch64 (GH200 / Grace Hopper)
    KiloSort4Version 4.0.38
    SpikeInterfaceVersion 0.103.0

%post
    export DEBIAN_FRONTEND=noninteractive

    # The PyPI scipy ARM64 wheel bundles OpenBLAS with a buggy NEOVERSEN2
    # kernel that crashes on GH200 Grace (288 hw threads > MAX_THREADS=128).
    # Fix: recompile scipy from source so it links against system BLAS
    # instead of bundling the broken one. The NGC PyTorch image already has
    # gfortran and NVPL/OpenBLAS dev libraries pre-installed.
    pip install --no-cache-dir --no-binary scipy scipy

    # Install the rest (scipy already satisfied from source build above)
    pip install --no-cache-dir \
        kilosort==4.0.38 \
        spikeinterface[full]==0.103.0 \
        "aind-data-schema<2.0" \
        aind-log-utils==0.2.3

%environment
    export DEBIAN_FRONTEND=noninteractive
    export OPENBLAS_NUM_THREADS=64

%runscript
    exec python "$@"
