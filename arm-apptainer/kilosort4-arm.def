# KiloSort4 container for ARM64 (NVIDIA GH200 / Grace Hopper)
#
# Build on Dardel gh node:
#   apptainer build --mksquashfs-args "-comp lz4" \
#     /cfs/klemming/projects/supr/dmclab/apptainer_cachedir/kilosort4-arm.sif \
#     kilosort4-arm.def
#
# NOTE: --squashfs-opts "-comp lz4" is required — GH200 compute nodes only support lz4,
# not the default zlib compression.

Bootstrap: docker
From: nvcr.io/nvidia/pytorch:26.02-py3

%labels
    Author aind-ephys-pipeline
    Architecture aarch64 (GH200 / Grace Hopper)
    KiloSort4Version 4.0.38
    SpikeInterfaceVersion 0.103.0

%post
    export DEBIAN_FRONTEND=noninteractive

    # scipy-openblas32 provides OpenBLAS 0.3.31 (MAX_THREADS=64) which
    # does not crash on GH200 Grace (288 hw threads).
    pip install --no-cache-dir scipy-openblas32

    # Install everything normally — no source build needed.
    pip install --no-cache-dir \
        kilosort==4.0.38 \
        spikeinterface[full]==0.103.0 \
        "aind-data-schema<2.0" \
        aind-log-utils==0.2.3

    # The scipy binary wheel bundles a broken OpenBLAS whose NEOVERSEN2
    # kernel segfaults on GH200 (sgemm_incopy_NEOVERSEN2 crash).
    # Replace it with the working library from scipy-openblas32.
    python -c "
import glob, os, shutil, scipy, scipy_openblas32

scipy_libs = os.path.join(os.path.dirname(scipy.__file__), '..', 'scipy.libs')
broken = glob.glob(os.path.join(scipy_libs, 'libscipy_openblas*.so'))
good = os.path.join(os.path.dirname(scipy_openblas32.__file__), 'lib', 'libscipy_openblas.so')

if not broken:
    raise FileNotFoundError('No libscipy_openblas*.so in ' + scipy_libs)

for lib in broken:
    print(f'Replacing {lib} ({os.path.getsize(lib)} bytes)')
    print(f'     with {good} ({os.path.getsize(good)} bytes)')
    shutil.copy2(good, lib)
"

%environment
    export DEBIAN_FRONTEND=noninteractive
    export OPENBLAS_NUM_THREADS=64

%runscript
    exec python "$@"
