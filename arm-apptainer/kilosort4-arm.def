# KiloSort4 container for ARM64 (NVIDIA GH200 / Grace Hopper)
#
# Build on Dardel gh node:
#   apptainer build --mksquashfs-args "-comp lz4" \
#     /cfs/klemming/projects/supr/dmclab/apptainer_cachedir/kilosort4-arm.sif \
#     kilosort4-arm.def
#
# NOTE: --squashfs-opts "-comp lz4" is required — GH200 compute nodes only support lz4,
# not the default zlib compression.

Bootstrap: docker
From: nvcr.io/nvidia/pytorch:26.02-py3

%labels
    Author aind-ephys-pipeline
    Architecture aarch64 (GH200 / Grace Hopper)
    KiloSort4Version 4.0.38
    SpikeInterfaceVersion 0.103.0

%post
    export DEBIAN_FRONTEND=noninteractive

    # Core spike-sorting stack
    # Note: apt-get is not available without fakeroot on Dardel (nosuid apptainer).
    # libfftw3-dev is already present in the NGC PyTorch base image.
    pip install --no-cache-dir \
        kilosort==4.0.38 \
        spikeinterface[full]==0.103.0 \
        "aind-data-schema<2.0" \
        aind-log-utils==0.2.3

%environment
    export DEBIAN_FRONTEND=noninteractive

%runscript
    exec python "$@"
