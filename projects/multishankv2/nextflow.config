// ---------------------------------------------------------------------------
// Multi-shank — Nextflow SLURM configuration for NAISS Dardel (GH200)
// KS4 + SpykingCircus2 + MountainSort5 + Tridesclous2 + Lupin
// Multi-shank aware: per-shank preprocessing, per-shank sorting + analysis.
// ---------------------------------------------------------------------------

params {
    // Paths — set via environment variables in slurm_submit.sh
    data_path    = System.getenv('DATA_PATH')
    results_path = System.getenv('RESULTS_PATH')
    cpu_sif      = System.getenv('CPU_SIF')
    ms5_sif      = System.getenv('MS5_SIF') ?: System.getenv('CPU_SIF')
    lupin_sif    = System.getenv('LUPIN_SIF') ?: System.getenv('CPU_SIF')
    nwb_sif      = System.getenv('NWB_SIF') ?: System.getenv('CPU_SIF')
    gpu_sif      = System.getenv('GPU_SIF')

    // publishDir mode
    publish_mode = 'link'

    // Queues
    default_queue = 'main'
    gpu_queue     = 'gpugh'
    shared_queue  = 'shared'

    // ── Preprocessing parameters (multishank-specific) ────────────────
    filter_type              = 'bandpass'    // 'highpass' or 'bandpass'
    use_spatial_filter       = true          // highpass spatial filter + AGC
    apply_motion_correction  = true          // apply drift interpolation

    // Curation thresholds
    curation_isi_max              = 0.5
    curation_presence_min         = 0.8
    curation_amplitude_cutoff_max = 0.1

    // Consensus
    consensus_agreement_threshold = 0.5
    consensus_min_agreement       = 2

    // Sorter toggles: disable individual sorters to skip them.
    // Usage: nextflow run ... --run_ks4 false --run_lupin false
    run_ks4   = true
    run_sc2   = true
    run_tdc2  = true
    run_lupin = true

    // NWB export: off by default
    run_nwb_export = false

    // Test mode: truncate recordings to first N seconds (0 = full recording).
    // Usage: nextflow run ... --test_duration_sec 600   (10 min)
    test_duration_sec = 0

    // Custom apptainer binary for GH200 ARM nodes
    apptainer_bin_dir = System.getenv('APPTAINER_BIN_DIR') ?:
                        "${System.getenv('HOME')}/Private/aind-ephys-pipeline/pipeline/bin_gh200"
}

// ---------------------------------------------------------------------------
// Container runtime
// ---------------------------------------------------------------------------

def hasApptainer = ['bash', '-c', 'command -v apptainer'].execute().waitFor() == 0
def hasSingularity = ['bash', '-c', 'command -v singularity'].execute().waitFor() == 0

if (hasApptainer) {
    apptainer {
        enabled     = true
        autoMounts  = true
        platform    = 'linux/amd64'
        envWhitelist = ['NUMBA_CACHE_DIR', 'HF_HOME', 'HF_HUB_OFFLINE', 'MPLCONFIGDIR',
                        'KACHERY_DIR', 'HDF5_USE_FILE_LOCKING', 'OPENBLAS_NUM_THREADS']
    }
} else if (hasSingularity) {
    singularity {
        enabled     = true
        autoMounts  = true
        platform    = 'linux/amd64'
        envWhitelist = ['NUMBA_CACHE_DIR', 'HF_HOME', 'HF_HUB_OFFLINE', 'MPLCONFIGDIR',
                        'KACHERY_DIR', 'HDF5_USE_FILE_LOCKING', 'OPENBLAS_NUM_THREADS']
    }
} else {
    throw new RuntimeException("Neither apptainer nor singularity found in PATH")
}

// ---------------------------------------------------------------------------
// Resource allocation
//
// Dardel shared partition: thin nodes (256 GB total, ~227 GB available).
// Proportional billing: charged for max(cores, memory/0.887).
// See projects/RESOURCE_ALLOCATION.md for full tables and measured RSS data.
//
// Measured peak RSS (4-shank NP2, 1005256, 71 min recording):
//                       Peak RSS   Cores  →  CPUs   Memory   Partition  Equiv charge
//   PREPROCESS:          149 GB    ~87       128    196 GB   shared     221 cores
//   SORT_KS4_BATCH:    13-16 GB    GPU       288    480 GB   gpugh      GPU alloc
//   SORT_SC2:          65-116 GB   ~13       128    150 GB   shared     169 cores
//   SORT_MS5:           9-30 GB    ~45        64    40 GB    shared     64 cores
//   SORT_TDC2:         18-21 GB    ~11        16    28 GB    shared     32 cores
//   SORT_LUPIN:           52 GB    ~14        64    68 GB    shared     77 cores
//   ANALYZE_KS4:      245-319 GB   ~30       128    230 GB   main       259 cores
//   ANALYZE_SC2:       99-211 GB   ~37       128    230 GB   main       259 cores
//   ANALYZE_TDC2:      17-26 GB    ~28        32    34 GB    shared     38 cores
//   ANALYZE_MS5:       32-91 GB    ~39        64    118 GB   shared     133 cores
//   ANALYZE_LUPIN:        26 GB    ~39        48    34 GB    shared     48 cores
//   ADVANCED_CURATE:     1-5 GB    ~1          4    8 GB     shared     9 cores
//   ADV_CURATE_LPN:        6 GB    ~1          4    8 GB     shared     9 cores
//   COMPARE:               1 GB    ~1          4    16 GB    shared     18 cores
// ---------------------------------------------------------------------------

process {
    executor       = 'slurm'
    queue          = params.default_queue
    clusterOptions = '--account=naiss2026-3-127'
    errorStrategy  = 'ignore'

    containerOptions = "--bind /cfs/klemming/projects/supr/dmclab:/cfs/klemming/projects/supr/dmclab"

    // PREPROCESS: 149 GB RSS (4 shanks parallel, mmap-heavy).
    // Main partition for reliable scheduling and headroom.
    withName: PREPROCESS {
        container     = params.cpu_sif
        cpus          = 128
        memory        = '230 GB'
        time          = { Math.max(60, (duration_minutes as int) * 1) + 'm' }
        errorStrategy = 'ignore'
    }

    // SORT_KS4_BATCH: all shanks sorted in parallel on 1 GPU node (4 GPUs).
    withName: SORT_KS4_BATCH {
        container      = params.gpu_sif
        cpus           = 288
        memory         = '480 GB'
        time           = { Math.max(30, (duration_minutes as int) * 1) + 'm' }
        queue          = params.gpu_queue
        clusterOptions = '--gres=gpu:4 --account=naiss2026-3-127-gh'
        containerOptions = "--nv --cleanenv --bind /cfs/klemming/projects/supr/dmclab:/cfs/klemming/projects/supr/dmclab"
        beforeScript = """
            chmod +x ${params.apptainer_bin_dir}/apptainer
            export PATH=${params.apptainer_bin_dir}:\$PATH
        """
    }

    // SORT_SC2: 158-195 GB RSS (per-shank, 71-min recording). ~3-8 real cores.
    // OMP template matching can stall on pathological chunks → needs generous time.
    // Retry strategy: attempt 1 uses 2x recording length; attempt 2 uses 15x for stalls.
    withName: SORT_SC2 {
        container     = params.cpu_sif
        cpus          = 128
        memory        = '230 GB'
        time          = { task.attempt == 1 ? Math.max(60, (duration_minutes as int) * 2) + 'm' : '1440m' }
        maxRetries    = 1
        errorStrategy = { task.exitStatus in [140, 143, 137] ? 'retry' : 'ignore' }
    }

    // SORT_MS5: disabled — consistently fails.
    // withName: SORT_MS5 {
    //     container = params.ms5_sif
    //     cpus      = 64
    //     memory    = '40 GB'
    //     time      = { Math.max(60, (duration_minutes as int) * 2) + 'm' }
    //     queue     = params.shared_queue
    // }

    // SORT_TDC2: 18-21 GB RSS, ~11 cores.
    withName: SORT_TDC2 {
        container = params.cpu_sif
        cpus      = 16
        memory    = '28 GB'
        time      = { Math.max(30, (duration_minutes as int) * 1) + 'm' }
        queue     = params.shared_queue
    }

    // SORT_LUPIN: 126 GB RSS (per-shank, 71-min recording). ~3-14 real cores.
    // OMP template matching can stall on pathological chunks → needs generous time.
    // Main (128 cores flat) cheaper than shared at this memory.
    withName: SORT_LUPIN {
        container = params.lupin_sif
        cpus      = 128
        memory    = '230 GB'
        time      = { Math.max(60, (duration_minutes as int) * 12) + 'm' }
    }

    withName: COMPARE {
        container = params.lupin_sif
        cpus      = 4
        memory    = '16 GB'
        time      = '30m'
        queue     = params.shared_queue
    }

    // ANALYZE_KS4: previously 317 GB with PCA; after PCA removal should be much lower.
    // Try main (230 GB) first — monitor on first run and upgrade if needed.
    withName: ANALYZE_KS4 {
        container = params.cpu_sif
        cpus      = 128
        memory    = '230 GB'
        time      = { Math.max(60, (duration_minutes as int) * 1) + 'm' }
    }

    // ANALYZE_SC2: 190 GB on per-shank (fits main), but may grow on other recordings.
    // Memory partition for safety headroom.
    withName: ANALYZE_SC2 {
        container = params.cpu_sif
        cpus      = 128
        memory    = '450 GB'
        time      = { Math.max(60, (duration_minutes as int) * 1) + 'm' }
        queue     = 'memory'
    }

    // ANALYZE_TDC2: 17-26 GB RSS.
    withName: ANALYZE_TDC2 {
        container = params.cpu_sif
        cpus      = 32
        memory    = '34 GB'
        time      = { Math.max(60, (duration_minutes as int) * 1) + 'm' }
        queue     = params.shared_queue
    }

    // ANALYZE_MS5: disabled — MS5 sorter consistently fails.
    // withName: ANALYZE_MS5 {
    //     container = params.cpu_sif
    //     cpus      = 64
    //     memory    = '118 GB'
    //     time      = { Math.max(60, (duration_minutes as int) * 1) + 'm' }
    //     queue     = params.shared_queue
    // }

    // ANALYZE_LUPIN: 26 GB RSS.
    withName: ANALYZE_LUPIN {
        container = params.lupin_sif
        cpus      = 48
        memory    = '34 GB'
        time      = { Math.max(60, (duration_minutes as int) * 1) + 'm' }
        queue     = params.shared_queue
    }

    withName: ADVANCED_CURATE {
        container = params.lupin_sif
        cpus      = 4
        memory    = '8 GB'
        time      = '30m'
        queue     = params.shared_queue
    }

    withName: ADV_CURATE_LPN {
        container = params.lupin_sif
        cpus      = 4
        memory    = '8 GB'
        time      = '30m'
        queue     = params.shared_queue
    }

    withName: COMPARE_CLEAN {
        container = params.lupin_sif
        cpus      = 4
        memory    = '16 GB'
        time      = '30m'
        queue     = params.shared_queue
    }

    withName: CONSENSUS_DELTA {
        container = params.lupin_sif
        cpus      = 2
        memory    = '4 GB'
        time      = '10m'
        queue     = params.shared_queue
    }

    withName: CURATE {
        container = params.cpu_sif
        cpus      = 4
        memory    = '16 GB'
        time      = '15m'
        queue     = params.shared_queue
    }

    withName: NWB_EXPORT {
        container = params.nwb_sif
        cpus      = 4
        memory    = '16 GB'
        time      = { Math.max(30, (duration_minutes as int) * 2) + 'm' }
        queue     = params.shared_queue
    }
}

// ---------------------------------------------------------------------------
// Reports
// ---------------------------------------------------------------------------

dag {
    enabled  = true
    file     = "${params.results_path}/nextflow/dag.html"
    overwrite = true
}

report {
    enabled  = true
    file     = "${params.results_path}/nextflow/report.html"
    overwrite = true
}

timeline {
    enabled  = true
    file     = "${params.results_path}/nextflow/timeline.html"
    overwrite = true
}

trace {
    enabled  = true
    file     = "${params.results_path}/nextflow/trace.txt"
    overwrite = true
}
