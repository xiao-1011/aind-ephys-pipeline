// ─────────────────────────────────────────────────────────────────────────────
// PFC v2 — Nextflow SLURM configuration for NAISS Dardel (GH200)
// KS4 + SpykingCircus2 + MountainSort5 + Tridesclous2
// ─────────────────────────────────────────────────────────────────────────────

params {
    // Paths — set via environment variables in slurm_submit.sh
    data_path    = System.getenv('DATA_PATH')
    results_path = System.getenv('RESULTS_PATH')
    cpu_sif      = System.getenv('CPU_SIF')
    ms5_sif      = System.getenv('MS5_SIF') ?: System.getenv('CPU_SIF')
    lupin_sif    = System.getenv('LUPIN_SIF') ?: System.getenv('CPU_SIF')
    nwb_sif      = System.getenv('NWB_SIF') ?: System.getenv('CPU_SIF')
    gpu_sif      = System.getenv('GPU_SIF')

    // publishDir mode: 'link' (hardlinks, no extra storage) requires same
    // filesystem for work dir and results dir — both under /cfs/klemming here.
    // Fall back to 'copy' if hardlinks are not supported.
    publish_mode = 'link'

    // Queues
    default_queue = 'main'
    gpu_queue     = 'gpugh'
    shared_queue  = 'shared'   // lightweight jobs (COMPARE, CURATE, NWB_EXPORT)

    // Curation thresholds (override via --curation_isi_max etc. on the CLI)
    curation_isi_max              = 0.5
    curation_presence_min         = 0.8
    curation_amplitude_cutoff_max = 0.1

    // Consensus: spike-overlap fraction to match units across sorters
    consensus_agreement_threshold = 0.5
    // Minimum number of sorters that must detect a unit to be flagged as consensus
    consensus_min_agreement       = 2

    // Sorter toggles: disable individual sorters to skip them on -resume.
    // Usage: nextflow run ... --run_ks4 false --run_lupin false
    run_ks4   = true
    run_sc2   = true
    run_tdc2  = true
    run_lupin = true

    // NWB export: off by default (manual curation precedes final NWB)
    run_nwb_export = false

    // Test mode: truncate recordings to first N seconds (0 = full recording).
    // Useful for smoke-testing pipeline wiring without waiting for full sorts.
    // Usage: nextflow run ... --test_duration_sec 600   (10 min)
    test_duration_sec = 0

    // Custom apptainer binary for GH200 ARM nodes
    apptainer_bin_dir = System.getenv('APPTAINER_BIN_DIR') ?:
                        "${System.getenv('HOME')}/Private/aind-ephys-pipeline/pipeline/bin_gh200"
}

// ─────────────────────────────────────────────────────────────────────────────
// Container runtime (apptainer preferred, singularity fallback)
// ─────────────────────────────────────────────────────────────────────────────

def hasApptainer = ['bash', '-c', 'command -v apptainer'].execute().waitFor() == 0
def hasSingularity = ['bash', '-c', 'command -v singularity'].execute().waitFor() == 0

if (hasApptainer) {
    apptainer {
        enabled     = true
        autoMounts  = true
        platform    = 'linux/amd64'
        envWhitelist = ['NUMBA_CACHE_DIR', 'HF_HOME', 'HF_HUB_OFFLINE', 'MPLCONFIGDIR',
                        'KACHERY_DIR', 'HDF5_USE_FILE_LOCKING', 'OPENBLAS_NUM_THREADS']
    }
} else if (hasSingularity) {
    singularity {
        enabled     = true
        autoMounts  = true
        platform    = 'linux/amd64'
        envWhitelist = ['NUMBA_CACHE_DIR', 'HF_HOME', 'HF_HUB_OFFLINE', 'MPLCONFIGDIR',
                        'KACHERY_DIR', 'HDF5_USE_FILE_LOCKING', 'OPENBLAS_NUM_THREADS']
    }
} else {
    throw new RuntimeException("Neither apptainer nor singularity found in PATH")
}

// ─────────────────────────────────────────────────────────────────────────────
// Resource allocation strategy for NAISS Dardel
//
// Dardel partitions:
//   - main:   whole-node exclusive (128 cores, 230 GB) — charged full node
//   - shared: per-core billing (≤256 CPUs, ≤111 GB, ≤7 days) — only pay for use
//   - gpugh:  GPU nodes (exclusive)
//
// Strategy: use shared for processes that fit under ~227 GB RSS (thin node).
// Shared partition: thin nodes (256 GB total, ~227 GB available), per-core billing.
// Cores and memory are proportionally linked — max(cores, memory) determines charge.
//
// Measured peak RSS (PFC full-probe, 999770 ~107 min, 2 probes):
//                       Peak RSS   Cores  →  CPUs   Memory   Partition  Equiv charge
//   PREPROCESS:        47–61 GB    128       128    96 GB    shared     128 cores
//   SORT_KS4_BATCH:    25–34 GB    GPU       288    480 GB   gpugh      GPU alloc
//   SORT_SC2:         141–162 GB   ~13       128    230 GB   main       128 cores
//   SORT_MS5:          42–54 GB    ~45        64    72 GB    shared     81 cores
//   SORT_TDC2:         64–84 GB    ~11       128    110 GB   shared     128 cores
//   SORT_LUPIN:        97–110 GB   ~14       128    144 GB   shared     162 cores
//   ANALYZE_KS4:      337–396 GB   ~12       128    230 GB   main       128 cores
//   ANALYZE_SC2:      276–309 GB   ~14       128    230 GB   main       128 cores
//   ANALYZE_TDC2:     127–155 GB   ~12       128    200 GB   shared     226 cores
//   ANALYZE_MS5:       20–51 GB    ~11        64    72 GB    shared     81 cores
//   ANALYZE_LUPIN:     69–81 GB    ~23        32    96 GB    shared     108 cores
//   ADVANCED_CURATE:    1–11 GB    ~1          4    16 GB    shared     18 cores
//   ADV_CURATE_LPN:       12 GB    ~1          4    16 GB    shared     18 cores
//   COMPARE:             2–3 GB    ~1          4    16 GB    shared     18 cores
// ─────────────────────────────────────────────────────────────────────────────

process {
    executor       = 'slurm'
    queue          = params.default_queue
    clusterOptions = '--account=naiss2026-3-127'
    errorStrategy  = 'ignore'

    containerOptions = "--bind /cfs/klemming/projects/supr/dmclab:/cfs/klemming/projects/supr/dmclab"

    // PREPROCESS: 169-186 GB RSS on 10-min test (mmap-heavy).
    // Full recordings will be higher — use main (whole node, 230 GB).
    withName: PREPROCESS {
        container     = params.cpu_sif
        cpus          = 128
        memory        = '230 GB'
        time          = { Math.max(30, (duration_minutes as int) * 1) + 'm' }
        errorStrategy = 'terminate'
    }

    // SORT_KS4_BATCH: up to 4 probes sorted in parallel on 1 GPU node (4 GPUs).
    // GH200 node: 4 × H100 GPUs, 288 ARM cores, ~1.92 TB RAM.
    // Each probe gets CUDA_VISIBLE_DEVICES=N → 1 GPU.
    // 4x GPU allocation savings vs. separate exclusive node per probe.
    // Time based on max duration in the batch (durs is a list).
    withName: SORT_KS4_BATCH {
        container      = params.gpu_sif
        cpus           = 288
        memory         = '480 GB'
        time           = { Math.max(30, ((durs instanceof List ? durs.max() : durs) as int) * 1) + 'm' }
        queue          = params.gpu_queue
        clusterOptions = '--gres=gpu:4 --account=naiss2026-3-127-gh'
        containerOptions = "--nv --cleanenv --bind /cfs/klemming/projects/supr/dmclab:/cfs/klemming/projects/supr/dmclab"
        beforeScript = """
            chmod +x ${params.apptainer_bin_dir}/apptainer
            export PATH=${params.apptainer_bin_dir}:\$PATH
        """
    }

    // SORT_SC2: 90-167 GB RSS on full recordings. ~13-18 real cores.
    // OMP template matching can stall on pathological chunks → generous time.
    // Main (128 cores flat) cheaper than shared at this memory (200 GB → 226 equiv cores).
    // Retry strategy: attempt 1 uses 2× recording length (covers 54-90 min observed);
    // attempt 2 uses 15× for pathological OMP stalls.
    withName: SORT_SC2 {
        container     = params.cpu_sif
        cpus          = 128
        memory        = '230 GB'
        time          = { Math.min(1440, Math.max(60, (duration_minutes as int) * (task.attempt == 1 ? 2 : 15))) + 'm' }
        maxRetries    = 1
        errorStrategy = { task.exitStatus in [140, 143, 137] ? 'retry' : 'ignore' }
    }

    // SORT_MS5: disabled — consistently fails.
    // withName: SORT_MS5 {
    //     container = params.ms5_sif
    //     cpus      = 64
    //     memory    = '72 GB'
    //     time      = { Math.max(60, (duration_minutes as int) * 3) + 'm' }
    //     queue     = params.shared_queue
    // }

    // SORT_TDC2: 64-84 GB RSS, ~11 cores. Memory-dominated (110 GB → ~124 equiv cores).
    // Give 128 cpus to match memory proportion — no extra cost, may help parallelism.
    withName: SORT_TDC2 {
        container = params.cpu_sif
        cpus      = 128
        memory    = '110 GB'
        time      = { Math.max(30, (duration_minutes as int) * 2) + 'm' }
        queue     = params.shared_queue
    }

    // SORT_LUPIN: 73-103 GB RSS on full recordings. ~11-14 real cores.
    // 2/8 timed out at 18h, 1/8 OOM at 257 GB. Unreliable for some sessions.
    // OMP template matching can stall on pathological chunks → generous time.
    withName: SORT_LUPIN {
        container = params.lupin_sif
        cpus      = 128
        memory    = '230 GB'
        time      = { Math.max(60, (duration_minutes as int) * 10) + 'm' }
    }

    withName: COMPARE {
        container = params.lupin_sif
        cpus      = 4
        memory    = '16 GB'
        time      = '30m'
        queue     = params.shared_queue
    }

    // ANALYZE_KS4: 142-217 GB without PCA (previously 327-610 GB with PCA).
    // Fits within main (230 GB) after PCA removal. Monitor on new animals.
    withName: ANALYZE_KS4 {
        container = params.cpu_sif
        cpus      = 128
        memory    = '230 GB'
        time      = { Math.max(60, (duration_minutes as int) * 1) + 'm' }
    }

    // ANALYZE_SC2: 241 GB on 10-min test, 276-309 GB on full recordings.
    // Already exceeds 230 GB even on short test → memory partition.
    withName: ANALYZE_SC2 {
        container = params.cpu_sif
        cpus      = 128
        memory    = '450 GB'
        time      = { Math.max(60, (duration_minutes as int) * 1) + 'm' }
        queue     = 'memory'
    }

    // ANALYZE_TDC2: 143-380 GB RSS on full recordings. day1/imec0 hit 380 GB,
    // far exceeding 230 GB main node. Must use memory partition for safety.
    withName: ANALYZE_TDC2 {
        container = params.cpu_sif
        cpus      = 128
        memory    = '450 GB'
        time      = { Math.max(60, (duration_minutes as int) * 1) + 'm' }
        queue     = 'memory'
    }

    // ANALYZE_MS5: disabled — MS5 sorter consistently fails.
    // withName: ANALYZE_MS5 {
    //     container = params.cpu_sif
    //     cpus      = 64
    //     memory    = '72 GB'
    //     time      = { Math.max(60, (duration_minutes as int) * 1) + 'm' }
    //     queue     = params.shared_queue
    // }

    // ANALYZE_LUPIN: 70-92 GB RSS on full recordings.
    // 120 GB → ~135 equiv cores on shared; 64 cpus avoids throttling.
    withName: ANALYZE_LUPIN {
        container = params.lupin_sif
        cpus      = 64
        memory    = '120 GB'
        time      = { Math.max(60, (duration_minutes as int) * 2) + 'm' }
        queue     = params.shared_queue
    }

    // ADVANCED_CURATE loads SortingAnalyzer (~10-20 GB), runs UnitRefine ML
    // inference + auto-merge. Well under 111 GB → shared partition.
    withName: ADVANCED_CURATE {
        container = params.lupin_sif
        cpus      = 4
        memory    = '16 GB'
        time      = '30m'
        queue     = params.shared_queue
    }

    // ADV_CURATE_LPN: day1/imec1 OOM'd at 16 GB. Raise to 32 GB.
    withName: ADV_CURATE_LPN {
        container = params.lupin_sif
        cpus      = 4
        memory    = '32 GB'
        time      = '30m'
        queue     = params.shared_queue
    }

    withName: COMPARE_CLEAN {
        container = params.lupin_sif
        cpus      = 4
        memory    = '16 GB'
        time      = '30m'
        queue     = params.shared_queue
    }

    withName: CONSENSUS_DELTA {
        container = params.lupin_sif
        cpus      = 2
        memory    = '4 GB'
        time      = '10m'
        queue     = params.shared_queue
    }

    withName: CURATE {
        container = params.cpu_sif
        cpus      = 4
        memory    = '16 GB'
        time      = '15m'
        queue     = params.shared_queue
    }

    withName: NWB_EXPORT {
        container = params.nwb_sif
        cpus      = 4
        memory    = '16 GB'
        time      = { Math.max(30, (duration_minutes as int) * 2) + 'm' }
        queue     = params.shared_queue
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Reports — written to results_path/nextflow/
// ─────────────────────────────────────────────────────────────────────────────

dag {
    enabled  = true
    file     = "${params.results_path}/nextflow/dag.html"
    overwrite = true
}

report {
    enabled  = true
    file     = "${params.results_path}/nextflow/report.html"
    overwrite = true
}

timeline {
    enabled  = true
    file     = "${params.results_path}/nextflow/timeline.html"
    overwrite = true
}

trace {
    enabled  = true
    file     = "${params.results_path}/nextflow/trace.txt"
    overwrite = true
}
