// Nextflow config for the NAISS Arrhenius HPC (strict syntax, Nextflow >= 26.04)
//
// Arrhenius specifics this config accounts for:
// - CPU nodes are x86-64 (2x AMD Turin, 256 logical cores, ~256 GB RAM).
//   GPU nodes are Arm (4x NVIDIA GH200 with Grace CPUs) and cannot run the
//   amd64 pipeline images, so Kilosort4 uses a locally built aarch64 image
//   (see environment/kilosort4_arm64.def).
// - All partitions are shared and billing is max(cores, memory-equivalent cores),
//   with ~0.85 GB RAM per logical core. CPU counts below are matched to the
//   memory request so the extra cores come at no additional cost.
// - Separate project accounts are required: <project>-cpu and <project>-gpu.
// - Apptainer images must live outside $HOME.
//
// Usage: see pipeline/arrhenius_submit.sh

params {
    executor = 'slurm'

    ecephys_path = env('DATA_PATH')
    results_path = env('RESULTS_PATH')
    params_file = "${projectDir}/active_params.json"

    // Fill in with the account names from `projinfo`, or pass --cpu_account / --gpu_account
    cpu_account = env('ARRHENIUS_CPU_ACCOUNT') ?: 'naissXXXX-XX-XX-cpu'
    gpu_account = env('ARRHENIUS_GPU_ACCOUNT') ?: 'naissXXXX-XX-XX-gpu'

    // aarch64 Kilosort4 image built on a GPU node from environment/kilosort4_arm64.def
    ks4_arm64_sif = env('KS4_ARM64_SIF') ?: '/nobackup/proj/disk/CHANGE_ME/containers/aind-ephys-spikesort-kilosort4_1.4.0_arm64.sif'

    apptainer_cache_dir = env('NXF_APPTAINER_CACHEDIR') ?: '/nobackup/proj/disk/CHANGE_ME/apptainer_cache'
}

executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10/1min'
    pollInterval = '30s'
}

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = params.apptainer_cache_dir
    pullTimeout = '2h'
    envWhitelist = ['KACHERY_ZONE', 'KACHERY_API_KEY', 'NUMBA_CACHE_DIR', 'HDF5_USE_FILE_LOCKING']
}

process {
    executor = 'slurm'
    queue = 'cpu'
    clusterOptions = "-A ${params.cpu_account}"

    cpus = 8
    memory = '6 GB'
    time = '1h'

    // Retry once with more memory/time when a job is OOM-killed or hits its walltime
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries = 1

    withName: validate_params {
        cpus = 2
        memory = '1 GB'
        time = '15m'
    }

    withName: job_dispatch {
        cpus = 38
        memory = '32 GB'
        time = { "${60 * task.attempt}m" }
    }

    withName: preprocessing {
        cpus = 94
        memory = { 80.GB * task.attempt }
        // 4x recording duration, at least 1h
        time = { "${[60, (max_duration_minutes.toFloat() * 4).toInteger()].max() * task.attempt}m" }
    }

    withName: spikesort_kilosort4 {
        queue = 'gpu'
        clusterOptions = "-A ${params.gpu_account} --gpus=1"
        container = params.ks4_arm64_sif
        containerOptions = '--nv'
        // GH200 node: check per-GPU core/memory share with `scontrol show node <gpu-node>`
        cpus = 32
        memory = { 64.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 4).toInteger()].max() * task.attempt}m" }
    }

    // CPU-only sorters run on the x86 CPU nodes with the stock images.
    // Kilosort 2.5 (compiled MATLAB, x86 + CUDA) has no aarch64 build and is not supported here.
    withName: spikesort_spykingcircus2 {
        cpus = 94
        memory = { 80.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 4).toInteger()].max() * task.attempt}m" }
    }

    withName: spikesort_lupin {
        cpus = 94
        memory = { 80.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 4).toInteger()].max() * task.attempt}m" }
    }

    withName: postprocessing {
        cpus = 94
        memory = { 80.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 4).toInteger()].max() * task.attempt}m" }
    }

    withName: curation {
        cpus = 38
        memory = '32 GB'
        // 10 min per recording hour, at least 30 min
        time = { "${[30, (max_duration_minutes.toFloat() / 6).toInteger()].max() * task.attempt}m" }
    }

    withName: visualization {
        cpus = 38
        memory = { 32.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 2).toInteger()].max() * task.attempt}m" }
    }

    withName: results_collector {
        cpus = 38
        memory = '32 GB'
        time = { "${[30, max_duration_minutes.toFloat().toInteger()].max() * task.attempt}m" }
    }

    withName: quality_control {
        cpus = 76
        memory = { 64.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 2).toInteger()].max() * task.attempt}m" }
    }

    withName: quality_control_collector {
        cpus = 16
        memory = '13 GB'
        time = { "${30 * task.attempt}m" }
    }

    // LFP export memory grows with the number of workers (N_JOBS_EXT = cpus),
    // so keep the worker count moderate and give it extra memory headroom.
    withName: nwb_ecephys {
        cpus = 16
        memory = { 64.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 2).toInteger()].max() * task.attempt}m" }
    }

    withName: nwb_units {
        cpus = 38
        memory = '32 GB'
        time = { "${[60, (max_duration_minutes.toFloat() * 2).toInteger()].max() * task.attempt}m" }
    }
}

dag {
    enabled = true
    file = "${params.results_path}/nextflow/dag.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.results_path}/nextflow/report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.results_path}/nextflow/timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.results_path}/nextflow/trace.txt"
    overwrite = true
}
