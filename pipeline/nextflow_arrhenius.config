// Nextflow config for the NAISS Arrhenius HPC (strict syntax)
//
// Arrhenius specifics this config accounts for (from `scontrol show node/partition`):
// - cpu partition: x86-64 nodes, 256 logical cores, ~755 GB RAM.
//   Billing per job = max(cpus, 0.37 * mem_GB), i.e. ~2.7 GB per core comes for free.
// - gpu partition: Arm (aarch64) nodes with 4x GH200 (120 GB), 288 Grace cores, ~475 GB RAM.
//   Billing = 1 unit per GPU; one GPU's share is 72 cores and ~100 GB RAM.
//   The published pipeline images are amd64-only, so Kilosort4 uses a locally
//   built aarch64 image (see environment/kilosort4_arm64.def).
// - Separate project accounts are required for each partition: <project>-cpu / <project>-gpu.
// - Apptainer images must live outside $HOME.
// - Partition walltime limit: 3 days.
//
// Usage: see pipeline/arrhenius_submit.sh

params {
    executor = 'slurm'

    ecephys_path = env('DATA_PATH')
    results_path = env('RESULTS_PATH')
    params_file = "${projectDir}/active_params.json"

    cpu_account = env('ARRHENIUS_CPU_ACCOUNT') ?: 'naiss2026-3-127-cpu'
    gpu_account = env('ARRHENIUS_GPU_ACCOUNT') ?: 'naiss2026-3-127-gpu'

    // aarch64 Kilosort4 image built on a GPU node from environment/kilosort4_arm64.def
    ks4_arm64_sif = env('KS4_ARM64_SIF') ?: '/nobackup/proj/disk/dmclab/personal/xiao1011/containers/aind-ephys-spikesort-kilosort4_1.4.0_arm64.sif'
    // Copy of that image's libcufft.so.11, written by scripts/build_kilosort4_arm64.sh (see spikesort_kilosort4)
    ks4_arm64_cufft = env('KS4_ARM64_CUFFT') ?: '/nobackup/proj/disk/dmclab/personal/xiao1011/containers/aind-ephys-spikesort-kilosort4_1.4.0_arm64_libcufft.so.11'

    apptainer_cache_dir = env('NXF_APPTAINER_CACHEDIR') ?: '/nobackup/proj/disk/dmclab/personal/xiao1011/apptainer_cache'

    // aind-units-nwb at the pinned 1.4.0 commit labels every shank of a multi-shank probe
    // "<probe>_group0" (SpikeInterface >= 0.105 resets the "group" property when slicing),
    // which fails with KeyError on the first channel of shank 1. Use the patched fork until
    // the fix is merged upstream.
    nwb_units_repo = 'https://github.com/xiao-1011/aind-units-nwb'
    nwb_units_commit = 'cdf8be6534dff7717938b370b7a920be2845e28a'

    // The pinned upstream preprocessing commit dumps binary_{name}.json before applying
    // motion, so requested DREDge correction never reached the sorter. This fork fixes
    // that handoff when DREDge is applied. For the KS4-only baseline, preprocessing
    // motion_correction.compute/apply are false and kilosort4.skip_motion_correction
    // is false; the sorter applies its own correction when enough channels remain.
    preprocessing_repo = 'https://github.com/xiao-1011/aind-ephys-preprocessing'
    preprocessing_commit = '194532bea663ec8382cb5404e83a3b8b9aac52e0'
}

executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10/1min'
    pollInterval = '30s'
}

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = params.apptainer_cache_dir
    pullTimeout = '2h'
    envWhitelist = ['KACHERY_ZONE', 'KACHERY_API_KEY', 'NUMBA_CACHE_DIR', 'HDF5_USE_FILE_LOCKING']
    // Nextflow runs containers with --no-home, which leaves $HOME pointing to a missing path
    // on the read-only image (tools writing ~/.cache then crash). Give each task a private,
    // writable home in its work dir. NXF_TASK_WORKDIR is expanded at runtime in .command.run.
    runOptions = '--home "$NXF_TASK_WORKDIR"'
}

// Billing is max(cpus, 0.37 * memory_GB); memory-heavy steps can be billed
// above their requested core count.
process {
    executor = 'slurm'
    queue = 'cpu'
    clusterOptions = "-A ${params.cpu_account}"

    cpus = 4
    memory = '10 GB'
    time = '1h'

    // Retry once with more memory/time when a job is OOM-killed or hits its walltime
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries = 1

    withName: validate_params {
        cpus = 1
        memory = '2 GB'
        time = '15m'
    }

    withName: job_dispatch {
        cpus = 12
        memory = '32 GB'
        time = { "${60 * task.attempt}m" }
    }

    withName: preprocessing {
        cpus = 48
        memory = { 128.GB * task.attempt }
        // 4x recording duration, at least 1h
        time = { "${[60, (max_duration_minutes.toFloat() * 4).toInteger()].max() * task.attempt}m" }
    }

    withName: spikesort_kilosort4 {
        queue = 'gpu'
        clusterOptions = "-A ${params.gpu_account} --gpus=1"
        container = params.ks4_arm64_sif
        // Apptainer mounts the image root through overlayfs here, and libcufft.so.11 loaded from
        // there fails every GPU FFT with CUFFT_INTERNAL_ERROR (Kilosort's highpass filter is the
        // first to hit it). The same file bound in from a plain filesystem works, so the copy
        // extracted at build time is bound over the image's one. Path follows the base image's Python.
        // OpenBLAS in the Arm image can segfault when its thread count exceeds its
        // compiled limit on 288-core Grace nodes. Set this inside the container,
        // before NumPy/SciPy imports; KS4 GPU compute is unaffected.
        containerOptions = "--nv --env OPENBLAS_NUM_THREADS=1,OMP_NUM_THREADS=1,MKL_NUM_THREADS=1,NUMEXPR_NUM_THREADS=1 -B ${params.ks4_arm64_cufft}:/usr/local/lib/python3.12/site-packages/nvidia/cufft/lib/libcufft.so.11"
        // One GH200's share of the node (billed as 1 GPU)
        cpus = 72
        memory = '100 GB'
        time = { "${[60, (max_duration_minutes.toFloat() * 4).toInteger()].max() * task.attempt}m" }
    }

    // CPU-only sorters run on the x86 CPU nodes with the stock images.
    // Kilosort 2.5 (compiled MATLAB, x86 + CUDA) has no aarch64 build and is not supported here.
    withName: spikesort_spykingcircus2 {
        cpus = 48
        memory = { 128.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 4).toInteger()].max() * task.attempt}m" }
    }

    withName: spikesort_lupin {
        cpus = 48
        memory = { 128.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 4).toInteger()].max() * task.attempt}m" }
    }

    // 48 workers only kept ~20-30 cores busy (PCA/metrics are single-threaded) at ~1.5 GB
    // per worker; 24 workers lose little wall time and bill max(24, 0.37*96) = 35.5 instead of 48.
    withName: postprocessing {
        cpus = 24
        memory = { 96.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 4).toInteger()].max() * task.attempt}m" }
    }

    withName: curation {
        // Opt in to a checksummed SI #4830 backport image after building it with
        // scripts/build_curation_si4830.sh. This override is not part of settings,
        // so changing it only invalidates curation and its downstream tasks.
        container = { env('CURATION_SIF') ?: "ghcr.io/allenneuraldynamics/aind-ephys-pipeline-base:${settings.container_tag}" }
        cpus = 12
        memory = '32 GB'
        // 10 min per recording hour, at least 30 min
        time = { "${[30, (max_duration_minutes.toFloat() / 6).toInteger()].max() * task.attempt}m" }
    }

    withName: visualization {
        cpus = 12
        memory = { 32.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 2).toInteger()].max() * task.attempt}m" }
    }

    withName: results_collector {
        cpus = 12
        memory = '32 GB'
        time = { "${[30, max_duration_minutes.toFloat().toInteger()].max() * task.attempt}m" }
    }

    withName: quality_control {
        cpus = 24
        memory = { 64.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 2).toInteger()].max() * task.attempt}m" }
    }

    withName: quality_control_collector {
        cpus = 4
        memory = '10 GB'
        time = { "${30 * task.attempt}m" }
    }

    // LFP export memory grows with the number of workers (N_JOBS_EXT = cpus): ~10 GB per
    // worker (16 workers were OOM-killed at 64 GB, and the kill surfaces as exit 1 from a
    // BrokenProcessPool, so it is not retried). Fewer workers, more memory.
    withName: nwb_ecephys {
        cpus = 8
        memory = { 128.GB * task.attempt }
        time = { "${[60, (max_duration_minutes.toFloat() * 2).toInteger()].max() * task.attempt}m" }
    }

    withName: nwb_units {
        cpus = 12
        memory = '32 GB'
        time = { "${[60, (max_duration_minutes.toFloat() * 2).toInteger()].max() * task.attempt}m" }
    }
}

dag {
    enabled = true
    file = "${params.results_path}/nextflow/dag.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.results_path}/nextflow/report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.results_path}/nextflow/timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.results_path}/nextflow/trace.txt"
    overwrite = true
}
