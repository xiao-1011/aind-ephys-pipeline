params {
    executor = 'local'

    // Environment variables override these machine-specific defaults.
    ecephys_path = env('DATA_PATH') ?: '/mnt/d/raw-ecephys/cohort07/20260428/vr2020260428_g0'
    results_path = env('RESULTS_PATH') ?: '/mnt/d/raw-ecephys/cohort07/20260428/vr2020260428_sorted'
    params_file = "${projectDir}/active_params.json"
}

process {
    executor = 'local'
    debug = true
    cpus = 8
    memory = '16 GB'
    containerOptions = '--memory-swap=-1 --memory-swappiness 20 --shm-size=4g'

    // Limit concurrent resource-intensive processes on the local machine.
    withName: preprocessing {
        maxForks = 1
    }

    withName: spikesort_kilosort4 {
        maxForks = 1
        containerOptions = '--gpus all'
    }

    withName: spikesort_kilosort25 {
        maxForks = 1
        containerOptions = '--gpus all'
    }

    withName: spikesort_spykingcircus2 {
        maxForks = 1
    }

    withName: postprocessing {
        maxForks = 1
    }

    withName: quality_control {
        maxForks = 1
    }

    // NWB LFP export is memory intensive. Limit its internal process pool to
    // one worker so it stays within the local 16 GB container memory limit.
    withName: nwb_ecephys {
        maxForks = 1
        cpus = 1
        containerOptions = '--env N_JOBS_EXT=1 --memory-swap=-1 --memory-swappiness 20 --shm-size=4g'
    }
}

docker {
    enabled = true
    runOptions = "--volume ${params.ecephys_path}:/tmp/data"
    envWhitelist = ['KACHERY_ZONE', 'KACHERY_API_KEY']
}

dag {
    enabled = true
    file = "${params.results_path}/nextflow/dag.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.results_path}/nextflow/report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.results_path}/nextflow/timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.results_path}/nextflow/trace.txt"
    overwrite = true
}
